{
  "id": "cloudbath-line-image-archive",
  "name": "Cloudbath LINE Image Archive",
  "description": "Archives universal LINE image assets and configurable Agent Profile business records.",
  "enabledByDefault": false,
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "wellness_notion_query",
      "wellness_notion_get_record",
      "wellness_notion_search",
      "construction_upload_create",
      "construction_upload_update"
    ]
  },
  "toolMetadata": {
    "wellness_notion_query": {
      "optional": true
    },
    "wellness_notion_get_record": {
      "optional": true
    },
    "wellness_notion_search": {
      "optional": true
    },
    "construction_upload_create": {
      "optional": true
    },
    "construction_upload_update": {
      "optional": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "version": {
        "const": 1
      },
      "agentProfiles": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "schemaProfiles": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    }
  }
}
