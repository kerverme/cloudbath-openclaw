# Runtime feature switches
CLOUDBATH_IMAGE_ARCHIVE_ENABLED=false
CLOUDBATH_IMAGE_ANALYSIS_ENABLED=false
IMAGE_MAX_MB=10

# Cloudflare R2 (keep the bucket private)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-private-r2-bucket
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_KEY_PREFIX=

# Canonical Notion write credential. Database IDs belong to Agent Profiles.
OPENCLAW_NOTION_WRITE_TOKEN=your-notion-write-integration-token

# Optional read-only Wellness connection. Never use this token for writes.
NOTION_WELLNESS_READ_TOKEN=your-read-only-wellness-integration-token

# One-time setup only; neither is a global runtime database setting.
NOTION_PARENT_PAGE_ID=your-shared-parent-page-id
NOTION_DATABASE_ID=your-existing-database-id
