# Feature switches
CLOUDBATH_IMAGE_ARCHIVE_ENABLED=false
CLOUDBATH_IMAGE_ANALYSIS_ENABLED=false

# Comma-separated LINE group IDs. Do not use display names.
LINE_ALLOWED_GROUP_IDS=C0123456789abcdef0123456789abcdef
IMAGE_MAX_MB=10

# Cloudflare R2 (keep the bucket private)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-private-r2-bucket
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_KEY_PREFIX=

# Notion
NOTION_API_KEY=your-notion-integration-token
NOTION_DATABASE_ID=your-notion-database-id
